<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The actual Material 3 palette is applied in Compose via ScopeTheme; this XML theme only
         sets what must exist before Compose ever runs (window background, cutout handling) so
         there is no flash of a different colour before the first frame is drawn. -->
    <style name="Theme.Scope" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: a phone with a USB-C plug in its bottom edge and a cable that leaves
     the phone through its right side and sweeps up to a lit endoscope probe.

     Geometry notes (108x108 viewport, adaptive-icon safe zone = the 66dp circle centred on 54,54):
       - the solid line art sits inside x = 28.5..83.5, y = 30..86.3, and no point of it is further
         than ~35.5 from (54,54), so nothing is clipped even by a circular mask (radius 36).
       - the lens disc is the tightest constraint the brief sets: its far edge is 32.6 from the
         centre, inside the 33 limit.
       - only the soft glow behind the lens is allowed past that; the r 9 ring grazes 36.1 and the
         r 12 ring reaches 39.1, both at <= 18 % white, so a mask cutting them is invisible.
       - the phone outline is one rounded rect (radius 5) drawn as two open sub-paths, leaving
         exactly two gaps: the bottom edge where the plug straddles it, and the right edge where
         the cable exits.
       - the cable is a single 4-cubic path whose joins are tangent-continuous, so it reads as one
         smooth line with no corners: straight up out of the plug, a wide arc right that crosses
         the phone's right edge horizontally, a gentle valley, then a reverse curve into the probe
         at 45 degrees. Its end tangent is the probe wedge's axis. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft glow behind the lens, two stops so the falloff does not band. -->
    <path
        android:pathData="M66,41.5 A12,12 0 1,0 90,41.5 A12,12 0 1,0 66,41.5 Z"
        android:fillColor="#14FFFFFF" />
    <path
        android:pathData="M69,41.5 A9,9 0 1,0 87,41.5 A9,9 0 1,0 69,41.5 Z"
        android:fillColor="#2EFFFFFF" />

    <!-- Phone outline, part 1: bottom-edge stub left of the plug, round to the bottom-left corner,
         up the left side, across the top and down the right side to where the cable exits. -->
    <path
        android:pathData="M35.5,78 L33.5,78 C30.7386,78 28.5,75.7614 28.5,73 L28.5,35 C28.5,32.2386 30.7386,30 33.5,30 L53.5,30 C56.2614,30 58.5,32.2386 58.5,35 L58.5,44.3"
        android:fillColor="#00000000"
        android:strokeColor="#E8F8F5"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Phone outline, part 2: below the cable gap, down the right side, round the bottom-right
         corner, back to where the plug interrupts the bottom edge. -->
    <path
        android:pathData="M58.5,57.6 L58.5,73 C58.5,75.7614 56.2614,78 53.5,78 L51.5,78"
        android:fillColor="#00000000"
        android:strokeColor="#E8F8F5"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Cable: one path, four cubics, tangent-continuous at every join. -->
    <path
        android:pathData="M43.5,72 C43.5,67 43.5,65 44.5,61 C46.44,53.24 52.5,50.5 58.5,50.5 C61.4,50.5 61.4,53.4 64.3,53.4 C66.6,53.4 67.4,52.11 69.52,49.99"
        android:fillColor="#00000000"
        android:strokeColor="#E8F8F5"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- USB-C plug body: 9 x 10, radius 2, straddling the phone's bottom edge. -->
    <path
        android:pathData="M41,72 L46,72 C47.1046,72 48,72.8954 48,74 L48,80 C48,81.1046 47.1046,82 46,82 L41,82 C39.8954,82 39,81.1046 39,80 L39,74 C39,72.8954 39.8954,72 41,72 Z"
        android:fillColor="#E8F8F5" />

    <!-- The plug's tab, 5 x 3.5, radius 1, just clear of the body. -->
    <path
        android:pathData="M42,82.8 L45,82.8 C45.5523,82.8 46,83.2477 46,83.8 L46,85.3 C46,85.8523 45.5523,86.3 45,86.3 L42,86.3 C41.4477,86.3 41,85.8523 41,85.3 L41,83.8 C41,83.2477 41.4477,82.8 42,82.8 Z"
        android:fillColor="#E8F8F5" />

    <!-- Probe: a 9-long wedge on the cable's end tangent, 4.5 wide at the cable (flush with the
         stroke, so there is no shoulder) tapering to 3 at the tip, which is buried in the lens. -->
    <path
        android:pathData="M67.93,48.4 L71.11,51.58 L76.94,44.69 L74.82,42.57 Z"
        android:fillColor="#E8F8F5" />

    <!-- Lens: body, a lighter inner ring, and a highlight. -->
    <path
        android:pathData="M72.5,41.5 A5.5,5.5 0 1,0 83.5,41.5 A5.5,5.5 0 1,0 72.5,41.5 Z"
        android:fillColor="#E8F8F5" />
    <path
        android:pathData="M74.8,41.5 A3.2,3.2 0 1,0 81.2,41.5 A3.2,3.2 0 1,0 74.8,41.5 Z"
        android:fillColor="#00000000"
        android:strokeColor="#C8ECEC"
        android:strokeWidth="1.2" />
    <path
        android:pathData="M74.45,39.6 A1.7,1.2 0 1,0 77.85,39.6 A1.7,1.2 0 1,0 74.45,39.6 Z"
        android:fillColor="#FFFFFFFF" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: a phone with a USB-C plug in its bottom edge and a cable that loops
     out of the phone's right side and sweeps up to a lit endoscope probe.

     Geometry notes (108x108 viewport, adaptive-icon safe zone = the 66dp circle centred on 54,54):
       - the line art sits inside x = 28..81, y = 29..85, and no point of it is further than ~34.5
         from (54,54), so nothing is clipped even by a circular mask (radius 36).
       - only the soft glow behind the lens is allowed to reach the edge; it is 10 % white, so a
         mask cutting it costs nothing.
       - the phone outline is deliberately drawn as two open sub-paths, leaving a gap in the bottom
         edge where the plug sits and a gap in the right edge where the cable leaves. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft glow behind the lens, two stops so the falloff does not band. -->
    <path
        android:pathData="M66.5,35.1 A9.2,9.2 0 1,0 84.9,35.1 A9.2,9.2 0 1,0 66.5,35.1 Z"
        android:fillColor="#1AFFFFFF" />
    <path
        android:pathData="M68.7,35.1 A7,7 0 1,0 82.7,35.1 A7,7 0 1,0 68.7,35.1 Z"
        android:fillColor="#26FFFFFF" />

    <!-- Phone outline, part 1: bottom-left stub, up the left side, across the top, down the right
         side to where the cable exits. -->
    <path
        android:pathData="M37.3,78 L32,78 C29.79,78 28,76.21 28,74 L28,33 C28,30.79 29.79,29 32,29 L54,29 C56.21,29 58,30.79 58,33 L58,41.5"
        android:fillColor="#00000000"
        android:strokeColor="#E8F8F5"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Phone outline, part 2: below the cable gap, down the right side, round the bottom-right
         corner, back to where the plug interrupts the bottom edge. -->
    <path
        android:pathData="M58,56 L58,74 C58,76.21 56.21,78 54,78 L52.7,78"
        android:fillColor="#00000000"
        android:strokeColor="#E8F8F5"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Cable: rises from the top of the plug inside the phone, leaves through the right edge,
         then sweeps right in an S and climbs to the probe. -->
    <path
        android:pathData="M45,69 C45,62 42,56 45.5,52 C49,48 53.5,47.2 58.5,48.6 C62,53.5 63.5,57 67,55.5 C69.5,54.4 68.1,49.43 69.6,46.6"
        android:fillColor="#00000000"
        android:strokeColor="#E8F8F5"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- USB-C plug body, sitting across the phone's bottom edge. -->
    <path
        android:pathData="M42.3,69 L47.7,69 C48.69,69 49.5,69.81 49.5,70.8 L49.5,78.2 C49.5,79.19 48.69,80 47.7,80 L42.3,80 C41.31,80 40.5,79.19 40.5,78.2 L40.5,70.8 C40.5,69.81 41.31,69 42.3,69 Z"
        android:fillColor="#E8F8F5" />

    <!-- The plug's tab, just clear of the body. -->
    <path
        android:pathData="M43.7,80.8 L46.3,80.8 C46.96,80.8 47.5,81.34 47.5,82 L47.5,83.4 C47.5,84.06 46.96,84.6 46.3,84.6 L43.7,84.6 C43.04,84.6 42.5,84.06 42.5,83.4 L42.5,82 C42.5,81.34 43.04,80.8 43.7,80.8 Z"
        android:fillColor="#E8F8F5" />

    <!-- Conical probe tip. Filled and stroked with the same colour so the corners round off. -->
    <path
        android:pathData="M68.28,45.9 L70.92,47.3 L77.75,38.47 L71.75,35.29 Z"
        android:fillColor="#E8F8F5"
        android:strokeColor="#E8F8F5"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Lens: body, a lighter inner ring, and a highlight. -->
    <path
        android:pathData="M70.2,35.1 A5.5,5.5 0 1,0 81.2,35.1 A5.5,5.5 0 1,0 70.2,35.1 Z"
        android:fillColor="#E8F8F5" />
    <path
        android:pathData="M72.6,35.1 A3.1,3.1 0 1,0 78.8,35.1 A3.1,3.1 0 1,0 72.6,35.1 Z"
        android:fillColor="#00000000"
        android:strokeColor="#CCFFFFFF"
        android:strokeWidth="1.4" />
    <path
        android:pathData="M72,33.2 A1.8,1.3 0 1,0 75.6,33.2 A1.8,1.3 0 1,0 72,33.2 Z"
        android:fillColor="#FFFFFFFF" />
</vector>

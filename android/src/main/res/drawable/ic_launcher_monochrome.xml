<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon (Android 13+) layer: the same paths as ic_launcher_foreground.xml reduced to a
     single-colour silhouette. Black is the convention - the system re-tints it from the wallpaper
     palette, so only the alpha of these paths matters. The glow, the lens ring and the highlight
     are dropped: at themed-icon contrast they would only muddy the shape.

     Every path below is byte-identical to its counterpart in ic_launcher_foreground.xml. Any edit
     there has to be mirrored here and in art/icon-play-512.svg. -->

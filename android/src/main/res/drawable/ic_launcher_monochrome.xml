        android:pathData="M35.5,78 L33.5,78 C30.7386,78 28.5,75.7614 28.5,73 L28.5,35 C28.5,32.2386 30.7386,30 33.5,30 L53.5,30 C56.2614,30 58.5,32.2386 58.5,35 L58.5,44.3"
        android:fillColor="#00000000"
